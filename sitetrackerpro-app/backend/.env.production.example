# ===== SiteTrackerPro production settings =====
PORT=3000
NODE_ENV=production

# PostgreSQL (from your hosting panel)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=sitetrackerpro_v3_enhanced

# Signs every login token. Generate: openssl rand -hex 32
JWT_SECRET=GENERATE_A_NEW_64_CHAR_HEX_SECRET

# Leave empty for same-origin (frontend served by this same server)
CORS_ORIGIN=
TRUST_PROXY=1

# Set to 1 after your team and clients have accounts, to stop public sign-ups.
DISABLE_REGISTRATION=0

# Sign-in protection (defaults shown)
# Failed attempts per account before a temporary lock, and how long it lasts.
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15

# Managed database URL (Neon, Supabase, Render, Aiven). When set it replaces the
# DB_USER/DB_PASSWORD/DB_HOST/DB_PORT/DB_NAME settings, and TLS is used
# automatically because the URL carries sslmode=require.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Where uploaded BIM files are written. Defaults to ./uploads beside the backend.
# UPLOAD_DIR=/var/lib/sitetrackerpro/uploads
