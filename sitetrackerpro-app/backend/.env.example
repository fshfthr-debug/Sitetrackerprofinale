# ==================== SITETRACKERPRO v3.0 ENHANCED .ENV ====================

# Backend Port
PORT=3000

# PostgreSQL Database
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sitetrackerpro_v3_enhanced

# Signs every login token. The app REFUSES TO START without a real value:
# 32+ characters, not this example, not one repeated pattern.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# Browser origins allowed to call the API cross-origin, comma separated.
# Leave empty for same-origin only (the normal deployment). A "*" is refused.
# Example: CORS_ORIGIN=https://app.example.com,http://localhost:3000
CORS_ORIGIN=

# How many proxies sit in front of the API. Caddy/nginx = 1, which lets rate
# limiting see the real client IP. Set to false only if the API is exposed directly.
TRUST_PROXY=1

# Hosted Site AI (optional). Without a key, Site AI keeps its built-in answers.
# Create a Standard API key at https://z.ai/manage-apikey/apikey-list
# glm-4.7-flash is free; override ZAI_MODEL to use a paid model.
ZAI_API_KEY=
ZAI_API_BASE=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.7-flash
# Hosted AI requests allowed per signed-in account per 15 minutes.
AI_RATE_LIMIT=30

# ==================== OBJECT STORAGE (OPTIONAL) ====================
# Uploaded models (.ifc/.glb), DEM GeoTIFFs and generated previews go to an S3-compatible
# bucket when S3_BUCKET is set, so they survive Render restarts and stay out of PostgreSQL.
# Leave S3_BUCKET empty for local development: files then stay in UPLOAD_DIR (backend/uploads).
# Supabase Storage: Project Settings -> Storage -> S3 Connection (access keys + endpoint).
# forcePathStyle is always on, as Supabase, MinIO and most S3-compatible endpoints require it.
S3_BUCKET=
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional key prefix inside the bucket, and lifetime of signed GET URLs in seconds (30-3600).
S3_PREFIX=
S3_SIGNED_URL_TTL_SECONDS=300

# Frontend
REACT_APP_API_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

# Sign-in protection (defaults shown)
# Failed attempts per account before a temporary lock, and how long it lasts.
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
