{
  "name": "sitetrackerpro",
  "version": "3.0.0",
  "private": true,
  "description": "SiteTrackerPro v3.0 Enhanced on Neon Postgres - build, migrate and run the whole app from here",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node sitetrackerpro-app/backend/backend-v3-enhanced.js",
    "db:migrate": "node scripts/migrate.js",
    "backup": "node scripts/backup.js",
    "backup:download": "node scripts/dump.js",
    "backup:schedule": "node scripts/schedule-backup.js",
    "db:restore": "node scripts/restore.js",
    "user:add": "node scripts/add-user.js",
    "user:list": "node scripts/add-user.js --list",
    "user:password": "node scripts/reset-password.js",
    "db:check": "node scripts/db-check.js"
  },
  "dependencies": {
    "@neon/config": "^1.14.2",
    "@neon/env": "^2.1.5",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.3",
    "pg": "^8.9.0"
  }
}
